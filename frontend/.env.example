# ---- Relish frontend (Next.js UI) ----
# Backend API address as reachable from the frontend SERVER (private network URL in production)
BACKEND_URL=http://localhost:4000
# Public address of this site, no trailing slash (used in table QR codes)
BASE_URL=http://localhost:3000
# Clickable demo-accounts panel on the sign-in page. Keep false in production.
DEMO_MODE=false
