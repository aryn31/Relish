{
  "name": "relish-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "photos": "tsx --env-file-if-exists=.env.local scripts/photos.ts",
    "unseed": "tsx --env-file-if-exists=.env.local scripts/unseed.ts",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
}
