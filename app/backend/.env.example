# ---- Relish backend (API) ----
# Postgres connection string
DATABASE_URL=postgres://relish:relish@localhost:5433/relish
# true for hosted Postgres that requires TLS (Render, Neon, Supabase, RDS…)
DATABASE_SSL=false
# Long random string. Generate: openssl rand -base64 48
SESSION_SECRET=change-me
# Super admin account, created on first start
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=change-me-strong-password
# Public address of the SITE (the frontend), no trailing slash — used in email links, QR downloads, Google redirect
BASE_URL=http://localhost:3000
PORT=4000
# Feature switches (off for now)
SETUP_FEE_ENABLED=false
EMAIL_VERIFICATION_ENABLED=false
# Optional Google sign-in (redirect URI: {BASE_URL}/api/google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
